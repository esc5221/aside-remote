# aside-remote configuration — copy to ~/.aside-remote/env (or <repo>/.env)
# Every key is optional; the bridge runs loopback-only with none of them set.
# Real environment variables override this file.

# --- binding ---
#ASIDE_REMOTE_HOST=127.0.0.1
#ASIDE_REMOTE_PORT=8799

# --- auth ---
# Bearer token file (the wizard generates ~/.aside-remote/token for you)
#ASIDE_REMOTE_TOKEN_FILE=~/.aside-remote/token

# --- Aside paths (defaults fit a standard install) ---
#ASIDE_BIN=~/.local/bin/aside
#ASIDE_USER_DIR=~/.aside/u/0
#ASIDE_DAEMON_URL=http://127.0.0.1:21420

# --- Cloudflare Access bootstrap (for phone / remote use) ---
#ASIDE_REMOTE_ACCESS_TEAM=yourteam.cloudflareaccess.com
#ASIDE_REMOTE_ACCESS_AUD=<Access application AUD tag>
#ASIDE_REMOTE_ACCESS_EMAILS=you@example.com
# service-token JSON ({"client_id": ..., "client_secret": ...}) for native shells
#ASIDE_REMOTE_CF_SERVICE_TOKEN_FILE=~/.aside-remote/cf_service_token.json
# extra allowed service-token common names, comma separated
#ASIDE_REMOTE_ACCESS_CNS=

# --- push notification on run completion (ntfy protocol) ---
#ASIDE_REMOTE_NTFY=https://ntfy.sh
#ASIDE_REMOTE_NTFY_TOPIC=my-unique-topic
#ASIDE_REMOTE_NTFY_ENABLED=1

# --- upload limit (bytes) ---
#ASIDE_REMOTE_UPLOAD_MAX=25165824
